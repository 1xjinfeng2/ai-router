# ===== AI Router 配置模板 =====
# 复制本文件为 .env 并填入对应密钥。未填写的供应商会在路由时被自动跳过。
# 脚本会优先读取环境变量，并自动加载本 .env（纯标准库实现，无需 python-dotenv）。
# ⚠️ .env 已被 .gitignore 排除，切勿把密钥提交到公开仓库。

# ── 国内平台 ────────────────────────────────────────────────
# 豆包 / 火山方舟
#   控制台首页: https://console.volcengine.com/ark
#   API Key 管理直链: https://ark.volcengine.com/region:cn-beijing/apiKey
#   开通管理: https://console.volcengine.com/ark/region:cn-beijing/openManagement
#   ① 注册并完成实名认证（未实名搜不到模型）
#   ② 记下控制台左下角「项目空间」— Key 与项目绑定，不同项目不通用
#   ③ 「开通管理」：建议勾选「全选 + 自动开通新增模型」
#      新用户每个模型有 50 万 token 免费额度，未开通也能先调用；
#      额度用完后在此开通服务即转为按量付费
#   ④ 「API Key 管理」→ 创建 API Key（只完整显示一次，立刻复制）
#      注意：2026-09-17 之后创建的 Key 改用新明文格式，不要靠前缀判断归属
#   ⑤ 自检：python scripts/check_provider.py --provider doubao --scan
#      （会拉取官方模型目录；模型 ID 换代时用 --model 覆盖）
#   控制台若显示「当前页面无法访问 / 404」：多为 SPA 前端路由或旧书签，
#   改用上面直链、先登录、选好左下角项目空间即可。
ARK_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
#   注册 → 充值余额（无免费额度，余额不足返回 402）→ 创建 Key
DEEPSEEK_API_KEY=

# Kimi / 月之暗面 — https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# 通义千问 / 阿里云百炼 — https://bailian.console.aliyun.com/ → API Key 管理
#   (旧版 DashScope 入口: https://dashscope.console.aliyun.com/apiKey)
DASHSCOPE_API_KEY=

# 智谱 GLM — https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
#   GLM-4.7-Flash 永久免费、无总量限制、200K 上下文（provider: glm-flash）
#   与 glm（glm-5，按量付费）共用同一个 Key
ZHIPU_API_KEY=

# 硅基流动 SiliconFlow — https://cloud.siliconflow.cn/account/ak
#   新户约 2000 万 tokens 赠金；部分小模型/embedding/OCR 永久免费（provider: siliconflow）
SILICONFLOW_API_KEY=

# 腾讯云 TokenHub — https://console.cloud.tencent.com/tokenhub/apikey
#   老混元平台 (api.hunyuan.cloud.tencent.com) 已于 2026-09 停服，现统一用 TokenHub。
#   ⚠️ 国内站点端点是 https://tokenhub.tencentmaas.com/v1 （注意：没有 cloud）
#      写成 tokenhub.tencentcloudmaas.com 会报 401002「Key 与 Base URL 不属于同一站点」
#   Key 管理：腾讯云控制台 → 大模型服务平台 TokenHub → API Key 管理
#   一个 Key 可调用 126 个模型（120 online）：hy4-preview / glm-5.3 / kimi-k3.1 /
#   deepseek-v4-pro / minimax-m3.1 / step-5 等；技能内已固化 6 个实测别名 th-*
#   （需在控制台先开通对应模型服务，未开通返回 402）
HUNYUAN_API_KEY=

# 文心一言 / 百度千帆 — https://console.bce.baidu.com/qianfan/ (应用接入 → API Key)
QIANFAN_API_KEY=

# ── 海外平台 ────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey (有免费额度)
GEMINI_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/api-keys (需绑定支付方式)
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys (需预充值)
ANTHROPIC_API_KEY=

# ── 免费额度线路（都不需要绑卡；详见 references/free-tier.md）──────
# Groq — https://console.groq.com/keys
#   30 RPM / 1000 次/天 / 8K TPM（每模型），速度最快（provider: groq）
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
#   25+ 个 :free 模型，20 RPM / 50 次/天；充过 $10 提到 1000 次/天（provider: openrouter）
OPENROUTER_API_KEY=

# Mistral — https://console.mistral.ai/api-keys (Experiment 计划约 $10/月额度)
#   注意：默认会用你的输入训练模型，需在控制台关闭（provider: mistral）
MISTRAL_API_KEY=

# NVIDIA NIM — https://build.nvidia.com → 任一模型 → Get API Key
#   全目录模型免费试原型，多数 40 RPM（provider: nvidia）
NVIDIA_API_KEY=

# ── 路由开关（可选）─────────────────────────────────────────
# 默认「自动路由」已内置排除无免费额度的线路：openai（需绑卡）、
# claude（需预充值）、deepseek（直连 DEEPSEEK_API_KEY 无免费额度）。
# 这些只会在你显式写 --provider openai 等时才调用，自动模式永不选它们。
# 想彻底关掉其中某个别名（如改用 th-deepseek / ark-deepseek 走免费额度），
# 或排除其他暂时不可用的线路（余额为 0、Key 停用），写在这里，逗号分隔。
# 自动路由与降级都会跳过它们；显式 --provider 仍会尝试并如实报错。
# 对应模型仍然可以用聚合平台别名访问：deepseek → th-deepseek / ark-deepseek
# AI_ROUTER_SKIP_PROVIDERS=openai,claude
AI_ROUTER_SKIP_PROVIDERS=

# ── 免费线路运行时缓存（可选）─────────────────────────────────
# OpenRouter :free 模型发现结果 + 限流冷却状态，默认技能根目录
# free_tier_cache.json（已排除出 git 与分发包）。目录只读时指向可写路径。
# AI_ROUTER_FREE_CACHE=/var/cache/ai-router/free_tier_cache.json

# ── 数据落盘位置（可选）───────────────────────────────────────
# 默认写在技能根目录的 usage.db / privacy_vault.db。
# 技能目录只读（打包安装、systemd ProtectSystem=strict）时改到可写目录。
AI_ROUTER_USAGE_DB=
AI_ROUTER_VAULT_DB=

# ── 自建 / 私有模型服务（provider: custom）────────────────────
# 服务器上跑 vLLM / Ollama / LM Studio / one-api 网关时填这里，走你自己的 GPU。
# 本地服务通常不需要 Key，留空即可（代码会发一个占位 Bearer）。
# AI_ROUTER_CUSTOM_ROUTES 决定它接哪些任务，默认只接低风险的 cheap；
# 想全量使用写 cheap,chinese,structured；留空 = 只在显式 --provider custom 时使用。
AI_ROUTER_CUSTOM_BASE_URL=
AI_ROUTER_CUSTOM_MODEL=
AI_ROUTER_CUSTOM_API_KEY=
AI_ROUTER_CUSTOM_ROUTES=cheap

# ── 服务端 / 客户端模式（scripts/server.py）──────────────────
# 部署成 HTTP 服务：AI_ROUTER_SERVER_TOKEN 是访问口令，非回环地址必须设置。
# 客户端模式：在另一台机器上填下面两行，ask.py 就会把请求转给服务器，
# 本机不再需要任何厂商 Key。
AI_ROUTER_SERVER_TOKEN=
AI_ROUTER_SERVER=
# AI_ROUTER_SERVER=http://127.0.0.1:8787
# AI_ROUTER_SERVER_TOKEN=please-change-me

# ── 通用提醒 ────────────────────────────────────────────────
# 1. Key 通常只在创建时完整显示一次，复制后立即保存；丢了只能重建。
# 2. 国内平台普遍需要先完成实名认证。
# 3. 最小可用组合：方舟 ARK_API_KEY + TokenHub HUNYUAN_API_KEY 两个 Key，
#    已覆盖豆包 / 混元 / DeepSeek / Kimi / GLM / MiniMax / Step 等主流国内模型。
# 4. 方舟一个 ARK_API_KEY 还能调用托管的多家模型（无需再申请各家 Key）：
#    --provider ark-deepseek / ark-kimi / ark-glm
# 5. TokenHub 同理，一个 HUNYUAN_API_KEY 对应 6 个实测别名：
#    --provider th-code / th-deepseek / th-flash / th-kimi / th-glm / th-minimax
#    用 check_provider.py --provider hunyuan --scan 查看全部 126 个模型 ID。
