# Secrets — never commit
.env

# Local PII vault (privacy relay) — contains real redacted values, never commit
privacy_vault.db
# Local usage meter (token/cost tracking) — never commit
usage.db
*.db
# One-shot "encryption hint already shown" marker written beside the vault
*.enc-hint
# Runtime cache: OpenRouter free-model discovery + soft-failure cooldown state
free_tier_cache.json

# Python cache
__pycache__/
*.pyc

# OS noise
.DS_Store
Thumbs.db

# Generated artifacts / distributable zips
*.zip
dist/
build/

# Local editor / tooling
.idea/
.vscode/
*.log

# Agent-side working notes (automation memory, local scratch) — never published
.workbuddy/
